# Suppress deprecated npm config warnings
# These warnings appear in npm 11.x for legacy config options
loglevel=error

# sanity-plugin-bulk-actions-table declares peer dep sanity@^3, but its code
# only uses stable @sanity/ui / sanity/structure APIs and works fine against
# sanity@5 (same mismatch exists upstream in other TeeQuest studios on v4).
legacy-peer-deps=true

