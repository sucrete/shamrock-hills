    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "playwright": "^1.62.1",
    "postcss": "^8.0.9",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
