{
  "name": "shamrock-hills-golf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --turbopack -p 3033\" \"npm run editor-css:watch\"",
    "build": "npm run editor-css && next build",
    "start": "next start -p 3032",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "editor-css": "postcss src/styles/editor.entry.css -o public/editor.css --config postcss-editor",
    "editor-css:watch": "postcss src/styles/editor.entry.css -o public/editor.css --config postcss-editor --watch",
    "postinstall": "tsx folder-rename.ts --utb"
  },
  "dependencies": {
